{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@file-sharing-app/common(.*)$": "<rootDir>/../../packages/common/src$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest-setup.ts"]
}

