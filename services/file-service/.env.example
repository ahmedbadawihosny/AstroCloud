# File Service – copy to .env
PORT=3002
MONGODB_URI=mongodb://localhost:27018/file_db
NATS_URL=nats://localhost:4222
FILE_S3_REGION=us-east-1
FILE_S3_BUCKET=files
FILE_S3_ACCESS_KEY=your-aws-access-key-id
FILE_S3_SECRET_KEY=your-aws-secret-access-key
FILE_MAX_UPLOAD_SIZE_BYTES=104857600
FILE_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
FILE_SHARE_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
