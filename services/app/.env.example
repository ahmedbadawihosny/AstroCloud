# Application
NODE_ENV=development

# PostgreSQL — two logical databases (TypeORM connections "auth" and "files").
# Docker Compose: user/password/db match postgres service; auth_db = POSTGRES_DB, file_sharing_db = infra/postgres/init-databases.sql
# Local (no Docker): create both databases and a role, or use the same URLs after `docker compose up postgres`.
# Then: pnpm run migration:run
DATABASE_URL_AUTH=postgresql://fileshare:fileshare@localhost:5432/auth_db
DATABASE_URL_FILE_SHARING=postgresql://fileshare:fileshare@localhost:5432/file_sharing_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# NATS
NATS_URL=nats://localhost:4222

# Files module → S3-compatible storage
FILE_S3_REGION=us-east-1
FILE_S3_BUCKET=your-files-bucket
FILE_S3_ACCESS_KEY=your-files-access-key
FILE_S3_SECRET_KEY=your-files-secret-key
FILE_MAX_UPLOAD_SIZE_BYTES=104857600
FILE_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
FILE_SHARE_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900

# Profile / auth uploads → S3
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your-aws-access-key
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-profile-bucket-name

# API Gateway (optional, for local tooling)
API_GATEWAY_URL=http://localhost:4000

LOG_LEVEL=info
LOG_FORMAT=combined
